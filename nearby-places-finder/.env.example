# Copy this file to ".env" (no real secrets are committed).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=places
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
# DB_HOST is set to "db" by docker-compose. Use "localhost" only if you run Django outside Docker.

# Frontend (browser) -> backend URL
VITE_API_URL=http://localhost:8000/api
